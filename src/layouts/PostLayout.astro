---
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, tags, draft } = post.data;
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));
---

<BaseLayout title={title} description={description} ogType="article">
  <meta slot="head" property="article:published_time" content={date.toISOString()} />

  <article class="post">
    <header class="page-head post__head boot">
      <p class="page-head__crumb"><a href="/writing/">Writing</a> / {post.id}</p>
      <h1>{title}</h1>
      <p class="page-head__lede">{description}</p>
      <dl class="post__meta">
        <div><dt class="label">Published</dt><dd><time datetime={date.toISOString()}>{formatDate(date)}</time></dd></div>
        <div><dt class="label">Read</dt><dd>{minutes} min</dd></div>
        {
          tags.length > 0 && (
            <div>
              <dt class="label">Tags</dt>
              <dd class="post__tags">{tags.map((t) => <span class="tag">{t}</span>)}</dd>
            </div>
          )
        }
        {draft && <div><dt class="label">Status</dt><dd class="placeholder">DRAFT (dev only)</dd></div>}
      </dl>
    </header>

    <div class="prose boot">
      <slot />
    </div>

    <footer class="post__foot">
      <a class="btn" href="/writing/"><span class="btn__key" aria-hidden="true">←</span> All writing</a>
      <a class="btn" href="/writing/rss.xml">RSS <span class="btn__key" aria-hidden="true">⌁</span></a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post { max-width: var(--measure); margin-inline: auto; }
  .post__head h1 { font-size: var(--fs-xl); }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin: var(--s-2) 0 0;
    font-size: var(--fs-sm);
  }
  .post__meta dd { margin: 0; color: var(--c-amber); }
  .post__tags { display: flex; flex-wrap: wrap; gap: var(--s-1); }
  .post__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-7);
    padding-top: var(--s-4);
    border-top: var(--border);
  }
</style>

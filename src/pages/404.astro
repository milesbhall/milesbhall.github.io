---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="This page doesn't exist.">
  <section class="panel panel--ticks nf boot" aria-labelledby="nf-h">
    <div class="panel__head">
      <span class="panel__code">ERR</span>
      <h1 id="nf-h">404: Route not found</h1>
    </div>
    <div class="panel__body nf__body">
      <p><span class="accent">&gt;</span> No page at this address.<span class="cursor" aria-hidden="true"></span></p>
      <div class="nf__links">
        <a class="btn btn--primary" href="/">Home <span class="btn__key" aria-hidden="true">F1</span></a>
        <a class="btn" href="/projects/">Projects <span class="btn__key" aria-hidden="true">F2</span></a>
        <a class="btn" href="/writing/">Writing <span class="btn__key" aria-hidden="true">F3</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { max-width: 40rem; margin: var(--s-7) auto; }
  .nf__body { display: grid; gap: var(--s-4); }
  .nf__links { display: flex; flex-wrap: wrap; gap: var(--s-2); }
</style>

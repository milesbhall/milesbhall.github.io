---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

// Drop a new file at public/resume.pdf and this page picks it up on the next build.
const hasResume = existsSync(join(process.cwd(), 'public', 'resume.pdf'));
---

<BaseLayout title="Resume" description="Resume of Miles Hall, Applied Math and Computer Science student at William & Mary.">
  <header class="page-head boot">
    <p class="page-head__crumb"><a href="/">Home</a> / Resume</p>
    <h1>Resume</h1>
    <div class="actions">
      {
        hasResume ? (
          <>
            <a class="btn btn--primary" href="/resume.pdf" download="Miles-Hall-Resume.pdf">
              Download PDF <span class="btn__key" aria-hidden="true">↓</span>
            </a>
            <a class="btn" href="/resume.pdf">
              Open in new tab <span class="btn__key" aria-hidden="true">↗</span>
            </a>
          </>
        ) : (
          <p class="placeholder missing">
            [PLACEHOLDER] Resume PDF not uploaded yet. Add it at <code>public/resume.pdf</code>.
          </p>
        )
      }
    </div>
  </header>

  {
    hasResume && (
      <section class="panel viewer boot" aria-label="Resume preview">
        <div class="panel__head">
          <span class="panel__code">PDF</span>
          <h2>resume.pdf</h2>
        </div>
        <object data="/resume.pdf#view=FitH" type="application/pdf" class="viewer__frame">
          <p class="viewer__fallback">
            Your browser can't show PDFs inline. <a href="/resume.pdf">Open the resume PDF</a> instead.
          </p>
        </object>
      </section>
    )
  }
</BaseLayout>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-2); }
  .missing { padding: var(--s-3) var(--s-4); font-size: var(--fs-sm); }
  .missing code { color: inherit; }
  .viewer__frame {
    display: block;
    width: 100%;
    height: min(110vh, 72rem);
    border: 0;
    background: var(--c-panel-2);
  }
  .viewer__fallback { padding: var(--s-5) var(--s-4); }
  /* Phones rarely render inline PDFs well, so lean on the buttons above */
  @media (max-width: 640px) {
    .viewer__frame { height: 80vh; }
  }
</style>

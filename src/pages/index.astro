---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts, getProjects, formatMonth, formatDate } from '../lib/content';

const [posts, projects] = await Promise.all([getPosts(), getProjects()]);

const links = [
  { code: 'LNKD', label: 'LinkedIn', display: 'linkedin.com/in/milesbhall', href: 'https://www.linkedin.com/in/milesbhall/', external: true },
  { code: 'GTHB', label: 'GitHub', display: 'github.com/milesbhall', href: 'https://github.com/milesbhall', external: true },
  { code: 'RSME', label: 'Resume', display: '/resume/', href: '/resume/', external: false },
  { code: 'FEED', label: 'RSS', display: '/writing/rss.xml', href: '/writing/rss.xml', external: false },
];
---

<BaseLayout>
  <div class="grid">
    <section class="panel panel--ticks profile boot" aria-labelledby="about-h">
      <div class="panel__head">
        <span class="panel__code">01</span>
        <h2 id="about-h">About</h2>
        <span class="panel__meta">PROFILE</span>
      </div>
      <div class="panel__body profile__body">
        <h1 class="profile__name">Miles Hall<span class="cursor" aria-hidden="true"></span></h1>
        <ul class="profile__tags" role="list" aria-label="Focus areas">
          <li class="tag">Applied Math</li>
          <li class="tag">Computer Science</li>
          <li class="tag">AI / ML</li>
          <li class="tag">William &amp; Mary</li>
        </ul>
        <p class="profile__bio">
          I'm an undergraduate student at William &amp; Mary double majoring in Applied Math and Computer
          Science with a concentration in Artificial Intelligence and Machine Learning. I'm obsessed with
          taking apart systems and machines to understand how they work. This curiosity has led me to
          pursue academic and financial research.
        </p>
        <div class="profile__cta">
          <a class="btn btn--primary" href="/projects/">View projects <span class="btn__key" aria-hidden="true">F2</span></a>
          <a class="btn" href="/resume/">Resume <span class="btn__key" aria-hidden="true">F4</span></a>
        </div>
      </div>
    </section>

    <section class="panel links boot" aria-labelledby="links-h">
      <div class="panel__head">
        <span class="panel__code">02</span>
        <h2 id="links-h">Links</h2>
        <span class="panel__meta">{links.length} ROUTES</span>
      </div>
      <ul class="links__list" role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href} rel={l.external ? 'me noopener' : undefined}>
                <span class="links__code" aria-hidden="true">{l.code}</span>
                <span class="links__text">
                  <span class="links__label">{l.label}</span>
                  <span class="links__url">{l.display}</span>
                </span>
                <span class="links__arrow" aria-hidden="true">{l.external ? '↗' : '→'}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="panel projects boot" aria-labelledby="proj-h">
      <div class="panel__head">
        <span class="panel__code">03</span>
        <h2 id="proj-h">Projects</h2>
        <span class="panel__meta"><a href="/projects/">ALL {projects.length} →</a></span>
      </div>
      <div class="tbl-wrap">
        <table class="tbl">
          <caption class="sr-only">Projects, newest first</caption>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Project</th>
              <th scope="col">Built for</th>
              <th scope="col">Award</th>
              <th scope="col">Date</th>
              <th scope="col">Team</th>
            </tr>
          </thead>
          <tbody>
            {
              projects.map((p, i) => (
                <tr>
                  <td class="tbl__n">{String(i + 1).padStart(2, '0')}</td>
                  <th scope="row" class="tbl__name">
                    <a href={`/projects/${p.id}/`}>{p.data.name}</a>
                  </th>
                  <td data-label="Built for">{p.data.event}</td>
                  <td data-label="Award" class="tbl__award">{p.data.award ?? '—'}</td>
                  <td data-label="Date" class="tbl__date">
                    <time datetime={formatDate(p.data.date).slice(0, 7)}>{formatMonth(p.data.date)}</time>
                  </td>
                  <td data-label="Team">{p.data.team}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel writing boot" aria-labelledby="writing-h">
      <div class="panel__head">
        <span class="panel__code">04</span>
        <h2 id="writing-h">Latest writing</h2>
        <span class="panel__meta"><a href="/writing/">ALL →</a></span>
      </div>
      <PostList posts={posts.slice(0, 5)} showDescription={false} headingLevel={3} />
    </section>
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--s-3);
  }
  .profile { grid-column: span 8; }
  .links { grid-column: span 4; }
  .projects { grid-column: span 12; }
  .writing { grid-column: span 12; }

  .panel__meta a { color: var(--c-cyan); text-decoration: none; }
  .panel__meta a:hover { color: var(--c-amber); }

  /* ---- Profile ---- */
  .profile__body {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-5) var(--s-5) var(--s-5);
  }
  .profile__name {
    font-size: clamp(2.25rem, 1.4rem + 4.5vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--c-text);
  }
  .profile__name .cursor { width: 0.42em; height: 0.8em; vertical-align: -0.04em; margin-left: 0.12em; }
  .profile__tags { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .profile__tags .tag:first-child { color: var(--c-amber); border-color: var(--c-amber); }
  .profile__bio {
    max-width: 62ch;
    font-size: var(--fs-lg);
    line-height: 1.65;
    color: var(--c-text);
  }
  .profile__cta { display: flex; flex-wrap: wrap; gap: var(--s-2); }

  /* ---- Links ---- */
  .links__list li + li { border-top: var(--border); }
  .links__list a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    color: var(--c-text);
    text-decoration: none;
  }
  .links__list a:hover { background: var(--c-panel-2); }
  .links__list a:hover .links__label,
  .links__list a:hover .links__arrow { color: var(--c-amber); }
  .links__code {
    font-size: var(--fs-2xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--c-cyan);
    border: 1px solid var(--c-cyan-dim);
    background: var(--c-cyan-dim);
    padding: 0.1rem 0.35rem;
  }
  .links__text { display: grid; min-width: 0; }
  .links__label { font-weight: 500; }
  .links__url {
    font-size: var(--fs-xs);
    color: var(--c-text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .links__arrow { color: var(--c-text-faint); }

  /* ---- Projects table ---- */
  .tbl-wrap { overflow-x: auto; }
  .tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  .tbl th, .tbl td {
    padding: var(--s-2) var(--s-4);
    text-align: left;
    border-bottom: var(--border);
    white-space: nowrap;
  }
  .tbl thead th {
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-faint);
    background: var(--c-panel);
  }
  .tbl tbody tr:last-child > * { border-bottom: 0; }
  .tbl tbody tr:hover { background: var(--c-panel-2); }
  .tbl__n { color: var(--c-text-faint); width: 1%; }
  .tbl__name { font-weight: 500; }
  .tbl__name a { color: var(--c-text); text-decoration: none; }
  .tbl__name a:hover { color: var(--c-amber); text-decoration: underline; }
  .tbl__award { color: var(--c-green); }
  .tbl__date { color: var(--c-amber); }

  @media (max-width: 960px) {
    .profile, .links { grid-column: span 12; }
  }

  /* On phones the table becomes stacked records */
  @media (max-width: 680px) {
    .profile__body { padding: var(--s-4); }
    .profile__bio { font-size: var(--fs-md); }
    .tbl thead { display: none; }
    .tbl, .tbl tbody, .tbl tr, .tbl th, .tbl td { display: block; }
    .tbl tr {
      display: grid;
      grid-template-columns: 2rem 1fr;
      padding: var(--s-3) var(--s-4);
      border-bottom: var(--border);
    }
    .tbl tbody tr:last-child { border-bottom: 0; }
    .tbl th, .tbl td { padding: 0; border: 0; white-space: normal; }
    .tbl__n { grid-row: span 5; padding-top: 0.1rem !important; }
    .tbl__name { font-size: var(--fs-md); margin-bottom: var(--s-1); }
    .tbl td[data-label] {
      display: grid;
      grid-template-columns: 5.5rem 1fr;
      font-size: var(--fs-xs);
    }
    .tbl td[data-label]::before {
      content: attr(data-label);
      color: var(--c-text-faint);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: var(--fs-2xs);
      padding-top: 0.1rem;
    }
  }
</style>

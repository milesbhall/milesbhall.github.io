---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { key: 'F1', href: '/', label: 'Home' },
  { key: 'F2', href: '/projects/', label: 'Projects' },
  { key: 'F3', href: '/writing/', label: 'Writing' },
  { key: 'F4', href: '/resume/', label: 'Resume' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path === href.replace(/\/$/, '') || path.startsWith(href));
---

<header class="hdr">
  <div class="hdr__strip">
    <div class="wrap hdr__strip-inner">
      <span><span class="hdr__dot" aria-hidden="true"></span>ONLINE</span>
      <span class="hdr__hide-sm">MILESHALL.COM</span>
      <span class="hdr__hide-sm">WILLIAM &amp; MARY · APPLIED MATH + CS</span>
    </div>
  </div>

  <div class="wrap hdr__bar">
    <a class="hdr__brand" href="/" aria-label="Miles Hall, home">
      <span class="hdr__logo" aria-hidden="true">MBH</span>
      <span class="hdr__name">Miles&nbsp;Hall</span>
    </a>

    <nav class="hdr__nav" aria-label="Primary">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                <span class="hdr__key" aria-hidden="true">{item.key}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .hdr {
    border-bottom: 1px solid var(--c-line-strong);
    background: var(--c-bg);
  }

  .hdr__strip {
    background: var(--c-amber);
    color: var(--c-bg);
    font-size: var(--fs-2xs);
    font-weight: 600;
    letter-spacing: 0.14em;
  }
  .hdr__strip-inner {
    display: flex;
    gap: var(--s-5);
    min-height: 1.5rem;
    align-items: center;
  }
  .hdr__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.5em;
    background: var(--c-bg);
    vertical-align: 1px;
    animation: blink 2.2s steps(1) infinite;
  }

  .hdr__bar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 3.25rem;
  }

  .hdr__brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--c-text);
    text-decoration: none;
  }
  .hdr__logo {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: var(--fs-sm);
    padding: 0.2rem 0.45rem;
    border: 2px solid var(--c-amber);
    color: var(--c-amber);
    letter-spacing: 0.04em;
  }
  .hdr__name {
    font-family: var(--f-display);
    font-weight: 500;
    font-size: var(--fs-sm);
    letter-spacing: 0.02em;
  }
  .hdr__brand:hover .hdr__logo { background: var(--c-amber); color: var(--c-bg); }

  .hdr__nav ul {
    display: flex;
    height: 100%;
  }
  .hdr__nav li { display: flex; }
  .hdr__nav a {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0 var(--s-4);
    border-left: 1px solid var(--c-line);
    color: var(--c-text-dim);
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .hdr__nav li:last-child a { border-right: 1px solid var(--c-line); }
  .hdr__key {
    font-size: var(--fs-2xs);
    color: var(--c-amber);
    border: 1px solid var(--c-amber-dim);
    padding: 0 0.25rem;
  }
  .hdr__nav a:hover { color: var(--c-text); background: var(--c-panel); }
  .hdr__nav a[aria-current='page'] {
    color: var(--c-bg);
    background: var(--c-amber);
  }
  .hdr__nav a[aria-current='page'] .hdr__key { color: var(--c-bg); border-color: var(--c-bg); }

  @media (max-width: 760px) {
    .hdr__hide-sm { display: none; }
    .hdr__bar {
      flex-direction: column;
      gap: 0;
      padding-inline: 0;
    }
    .hdr__brand { padding: var(--s-3) var(--gutter); }
    .hdr__nav ul {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-top: 1px solid var(--c-line);
    }
    .hdr__nav li { display: block; }
    .hdr__nav a {
      flex-direction: column;
      gap: 0.15rem;
      justify-content: center;
      min-height: 3rem;
      padding: var(--s-2) var(--s-1);
      font-size: var(--fs-2xs);
    }
    .hdr__nav li:first-child a { border-left: 0; }
    .hdr__nav li:last-child a { border-right: 0; }
  }
</style>

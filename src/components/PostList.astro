---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Show the description line under each title */
  showDescription?: boolean;
  headingLevel?: 2 | 3;
}

const { posts, showDescription = true, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}`;
---

{
  posts.length === 0 ? (
    <p class="empty">
      <span class="accent">&gt;</span> NO ENTRIES YET. First post coming soon.<span class="cursor" aria-hidden="true" />
    </p>
  ) : (
    <ol class="posts" role="list">
      {posts.map((post) => (
        <li class="post">
          <time class="post__date" datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
          <div class="post__main">
            <Heading class="post__title">
              <a href={`/writing/${post.id}/`}>{post.data.title}</a>
              {post.data.draft && <span class="tag post__draft">Draft</span>}
            </Heading>
            {showDescription && <p class="post__desc">{post.data.description}</p>}
            {post.data.tags.length > 0 && (
              <ul class="post__tags" role="list" aria-label="Tags">
                {post.data.tags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .empty {
    padding: var(--s-4);
    color: var(--c-text-dim);
    font-size: var(--fs-sm);
  }

  .posts { display: grid; }
  .post {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-4);
    border-bottom: var(--border);
  }
  .post:last-child { border-bottom: 0; }
  .post:hover { background: var(--c-panel-2); }

  .post__date {
    color: var(--c-amber);
    font-size: var(--fs-sm);
    padding-top: 0.1rem;
  }
  .post__title {
    font-size: var(--fs-md);
    font-weight: 500;
  }
  .post__title a { color: var(--c-text); text-decoration: none; }
  .post__title a:hover { color: var(--c-amber); text-decoration: underline; }
  .post__draft { margin-left: var(--s-2); color: var(--c-red); border-color: var(--c-red); vertical-align: 2px; }
  .post__desc {
    margin-top: var(--s-1);
    color: var(--c-text-dim);
    font-size: var(--fs-sm);
  }
  .post__tags { display: flex; flex-wrap: wrap; gap: var(--s-1); margin-top: var(--s-2); }

  @media (max-width: 560px) {
    .post { grid-template-columns: 1fr; gap: var(--s-1); }
  }
</style>

---
import { getPosts, getProjects } from '../lib/content';

const [posts, projects] = await Promise.all([getPosts(), getProjects()]);
const built = new Date();
const stamp = built.toISOString().replace('T', ' ').slice(0, 16) + 'Z';
---

<footer class="ftr">
  <div class="wrap ftr__inner">
    <dl class="ftr__stats">
      <div><dt>PROJ</dt><dd>{String(projects.length).padStart(2, '0')}</dd></div>
      <div><dt>POSTS</dt><dd>{String(posts.length).padStart(2, '0')}</dd></div>
      <div><dt>BUILD</dt><dd><time datetime={built.toISOString()}>{stamp}</time></dd></div>
    </dl>
    <ul class="ftr__links" role="list">
      <li><a href="https://www.linkedin.com/in/milesbhall/" rel="me">LinkedIn</a></li>
      <li><a href="https://github.com/milesbhall" rel="me">GitHub</a></li>
      <li><a href="/writing/rss.xml">RSS</a></li>
      <li><a href="/sitemap-index.xml">Sitemap</a></li>
    </ul>
    <p class="ftr__copy">© {built.getFullYear()} Miles Hall</p>
  </div>
</footer>

<style>
  .ftr {
    border-top: 1px solid var(--c-line-strong);
    background: var(--c-panel);
    font-size: var(--fs-xs);
    color: var(--c-text-faint);
  }
  .ftr__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    padding-block: var(--s-3);
  }
  .ftr__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin: 0;
  }
  .ftr__stats div { display: flex; gap: 0.5em; }
  .ftr__stats dt { color: var(--c-text-faint); letter-spacing: 0.1em; }
  .ftr__stats dd { margin: 0; color: var(--c-amber); }
  .ftr__links { display: flex; flex-wrap: wrap; gap: var(--s-4); }
  .ftr__links a { color: var(--c-text-dim); }
  .ftr__links a:hover { color: var(--c-amber); }
  .ftr__copy { margin-left: auto; }
  @media (max-width: 640px) {
    .ftr__copy { margin-left: 0; width: 100%; }
  }
</style>
